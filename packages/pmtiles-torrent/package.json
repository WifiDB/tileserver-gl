{
  "name": "pmtiles-torrent",
  "version": "0.1.0",
  "description": "Serve a PMTiles archive from a BitTorrent swarm — a torrent-backed Source for the pmtiles package",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.js",
    "./webtorrent": "./src/engines/webtorrent.js",
    "./libtorrent": "./src/engines/libtorrent.js"
  },
  "files": [
    "src",
    "sidecar",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "pmtiles",
    "bittorrent",
    "webtorrent",
    "torrent",
    "map",
    "tiles",
    "maplibre",
    "p2p"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "pmtiles": ">=3",
    "webtorrent": ">=2"
  },
  "peerDependenciesMeta": {
    "webtorrent": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || 24"
  }
}
